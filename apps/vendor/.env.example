# vendor app — domain: vendor.ttklia.com/{outlet} (doc 16, "Apps and API services"; doc 32)
# Deployed values come from SSM Parameter Store /ttklia/<env>/web/* (doc 16, "Front-end config at scale").
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_AUTH_URL=http://localhost:8000
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_SENTRY_DSN=
# The till talks to the counter agent on the till PC (doc 32, "Hardware").
# TODO(pending: docs) doc 16 lists NUXT_PUBLIC_AGENT_BASE for bus and taxi only; doc 32 needs it here too.
NUXT_PUBLIC_AGENT_BASE=http://127.0.0.1:8090
